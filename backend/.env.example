# ================================
# Application
# ================================
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:3000

# ================================
# Database (PostgreSQL)
# ================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=student_management
DB_USER=postgres
DB_PASSWORD=your_password_here

# ================================
# JWT (Access + Refresh Tokens)
# ================================
JWT_SECRET=change_this_to_a_long_random_secret_key_at_least_32_chars
JWT_REFRESH_SECRET=change_this_refresh_secret_key_at_least_32_chars
# Short-lived access token: 15m recommended in production
JWT_EXPIRES_IN=15m
# Long-lived refresh token
JWT_REFRESH_EXPIRES_IN=7d

# ================================
# Redis (BullMQ Email Queue)
# Omit REDIS_HOST to use direct email sending (no Redis required)
# ================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
# Worker concurrency for email processing
EMAIL_WORKER_CONCURRENCY=3

# ================================
# Email (SMTP)
# ================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
EMAIL_FROM_NAME=Student Management System

# ================================
# CORS
# ================================
CORS_ORIGIN=http://localhost:3000

# ================================
# Logging
# ================================
LOG_LEVEL=info
# Set to "true" to write logs/combined.log and logs/errors.log
LOG_TO_FILE=false
# Directory for log files (default: ./logs)
LOG_DIR=./logs

# ================================
# Absence Alert Threshold
# ================================
ABSENCE_THRESHOLD=3
